// simulation_spillover workflow with pseudo-bulks from HaoCleaned, and the main workflow on
// the purified bulk datasets.
includeConfig '../conf/norm.config'

params {
  data_dir_bulk                  = "/nfs/data/omnideconv_benchmarking_clean/data/spillover/"
  ncores                         = 8
  memory_scale                   = 5

  /*** simulation_spillover ***/
  results_dir_spillover          = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_rectangle_spillover2"
  single_cell_list               = ["HaoCleaned-sampled"]
  simulation_sc_dataset          = ["HaoCleaned"]
  simulation_n_cells             = [1000]
  simulation_n_samples           = [50]
  spillover_celltypes            = ["Tregs","T cells CD4 conv","T cells CD8","ILC","Plasma cells","NK cells","B cells","Monocytes","mDC","pDC","Platelet"]

  /*** main workflow on the purified datasets ***/
  results_dir_general            = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_rectangle_spillover2"
  bulk_list                      = ["hoek_purified","linsley_purified"]
}
