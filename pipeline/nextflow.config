includeConfig 'conf/manifest.config'

params {

  /*** input directories ***/
  data_dir_bulk = "/path/to/bulk/datasets/"                                                     // absolute path to directory that contains RNA-seq datasets
  data_dir_sc = "/path/to/singlecell/datasets/"                                                 // absolute path to directory that contains scRNA-seq datasets


  /*** output directories ***/  
  results_dir_general = "/path/to/results/"                                                     // absolute path to directory in which final results of the main, simulation and subsampling workflow are stored
  preProcess_dir = "/path/to/temporary/directory/"                                              // absolute path to directory in which subsampled and simulated datasets are stored
  

  /*** Benchmarking Parameters [general] ***/  
  single_cell_list = ["sc1"]                                                                    // list of scRNA-seq dataset names that will be used for deconvolution. 
  bulk_list = ["bulk1","bulk2"]                                                                 // list of RNA-seq dataset names that will be used for deconvolution. 
  method_list = ["dwls"]                                                                        // list of method names that are used for deconvolution. Possible values are the methods in optimal_normalizations.csv: ["autogenes","bayesprism","bisque","cibersortx","dwls","music","rectangle","scaden","scdc"]
  // music_hc_marker_fraction = 0.1                                                                // only for the method music-hc: share of the genes of a group used for the cell types inside the group
  // secret_with_unknown = true                                                                   // only for the method secret: also estimate the proportion of cell types that are not in the reference
  

  /*** general parameters ***/
  ncores = '4'                                                                                  // Number of cores that are available for methods
  species_sc = 'hs'                                                                             // Type of species in scRNA-seq dataset (mm or hs). Currently only supported by BayesPrism.


  /*** simulated bulk datasets (all workflows that simulate) ***/
  simulation_sc_dataset = ["sc1"]                                                               // names of the scRNA-seq datasets from which pseudo-bulks are simulated
  simulation_n_cells = [1000]                                                                   // number of cells per pseudo-bulk sample
  simulation_n_samples = [10]                                                                   // number of pseudo-bulk samples; several values are possible in the simulation and subsampling workflow
  simulation_scenario = ['mirror_db']                                                           // SimBu scenario (simulation workflow)
  simulation_bias_type = ['expressed_genes']                                                    // SimBu scaling factor (simulation workflow)

  /*** reference split by donor (optional) ***/
  // split_reference = true                                                                       // split datasets that are used for the simulation and as reference; the simulation gets the cells of one part of the donors, the methods the others
  // split_by = 'donor'                                                                           // 'donor': whole donors go to one part; 'cell': the cells of every cell type are split, every donor can be in both parts
  // split_fraction_simulation = 0.5                                                              // share of the donors (or of the cells of every cell type) for the simulation
  // split_min_cells = 50                                                                         // minimum number of cells of every cell type in each part
  // split_min_cells_action = 'error'                                                             // 'error' or 'warn' if a cell type has fewer cells
  // split_seed = 1                                                                               // seed of the donor assignment
  // split_reference_cells_fraction = 1                                                           // share of the cells of the method part that is kept


  /****** Workflow-specific parameters ******/


  /*** subsampling ***/
  ct_fractions = [1000, 5000]                                                                   // total number of cells in the subsampled scRNA-seq dataset
  replicates = 5                                                                                // number of replicates for subsampling
  

  /*** simulation_impact_technology ***/
  results_dir_impact_technology = "/path/to/impact_technology/results/"                         // results directory for this workflow
  replicates_simulation = [5]                                                                   // number of simulation replicates for this workflow and for simulation_resolution_analysis
  sc_datasets_impact_technology = ["lambrechts,maynard"]                                        // names of sc datasets whose common cell types are used, as one comma-separated string
  bulk_impact_technology = ["vanderbilt_lung"]                                                  // names of real bulk datasets that are deconvolved with each reference


  /*** simulation_spillover ***/
  results_dir_spillover = "/path/to/simulation_spillover/results/"                              // results directory for this workflow
  spillover_celltypes = ["B cells","Monocytes","NK cells","T cells CD8","T cells CD4 conv"]     // names of cell types for which spillover analysis will be done; have to be present in single-cell dataset                                     


  /*** simulation_unknown_content ***/
  results_dir_unknown_content = "/path/to/simulation_unknown_content/results/"                  // results directory for this workflow
  known_cell_types = ["B cells,Stromal cells,T cells CD4 conv,Macrophages"]                     // subset of cell types that we will use to build the signature matrix, as one comma-separated string
  unknown_cell_type = ["Tumor cells"]                                                           // unknown cell type to use
  fractions_unknown_cells = [0, 0.2, 0.3, 0.9]                                                  // How large the fraction of the unknown cell type is
  replicates_unknown_content = [5]                                                              // number of technical replicates for pseudo-bulk simulation
 

  /*** simulation_resolution_analysis ***/
  results_dir_resolution = "/path/to/simulation_resolution_analysis/results/"                   // results directory for this workflow
  cell_types_finer_res = ["Endothelial ACKR1, Endothelial RGS5, Endothelial CXCL12, ..."]       // which cell types will we inspect at various resolutions? Names from the fine annotation, as one comma-separated string


  /*** impact_missing_cell_types ***/
  results_dir_missing_cell_types = "/path/to/impact_missing_cell_types/results/"                // results directory for this workflow
  cell_types_to_exclude = ["B cells","mDC","Monocytes","NK cells","T cells CD4 conv","-"]       // each of the cell types that will be excluded from the single cell dataset before deconvolution; "-" excludes none
  simulation_missing_cell_types = false                                                         // true: also analyse pseudo-bulk datasets simulated from simulation_sc_dataset (simulation_* parameters above)

  
}


profiles {
     standard {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '50 GB'
        docker.enabled = false
     }
     docker {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '10 GB'
        docker.enabled = true
        process.container = 'omnideconv_benchmark:latest'
        docker.temp = "auto"
     }
     apptainer {
        process.executor = 'local'
        process.cpus = 4
        process.memory = '10 GB'
        apptainer.enabled = true
        process.container = 'omnideconv_benchmark.sif'
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /path/to/data,/path/to/results,/path/to/nextflow/work'     // bind data, results and the Nextflow work directory; do not bind the home directory if omnideconv is installed there!
     }
     slurm_no_docker {
        process.executor = 'slurm'
        process.cpus = 4
        process.memory = '50 GB'
        docker.enabled = false
     }
     slurm_docker {
        process.executor = 'slurm'
        process.cpus = 4
        process.memory = '50 GB'
        docker.enabled = true
        process.container = 'omnideconv_benchmark:latest'
        docker.temp = "auto"
     }
}

// this is necessary to run CIBERSORTx with a docker in docker environment. The local docker socket has to be mapped as a volume into the omnideconv_benchmark container, so that the CIBERSORTx container can be started inside
docker {  
  runOptions = '-v /var/run/docker.sock:/var/run/docker.sock -v /path/to/results/:/path/to/results/'
}

// use the `-with-trace` command to get tracing information on each job. Useful for the subsampling workflow, to see how resources scale with size of single-cell dataset
trace {
  fields = 'task_id,process,name,status,module,container,cpus,time,disk,memory,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,script'
  sep = ','
  overwrite = true
}
