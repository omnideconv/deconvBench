// Real-data check on the norm cluster: same profiles as the fixture tests, datasets and
// parameters close to the production configs in configs/, but reduced (fewer replicates and
// samples). Used to compare two versions of the pipeline on identical real inputs.
// TEST_INPUT is a directory created by tests/make_real_input.sh.

includeConfig '../conf/base.config'

// peak memory in the production runs on HaoCleaned-sampled was 34 GB (DWLS signature)
process {
   memory = 32.GB
   time   = 24.h

   withLabel:process_high {
      memory = 64.GB
   }
   withLabel:process_default {
      memory = 48.GB
   }
}
