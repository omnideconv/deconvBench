// DWLS for TCGA-BRCA (see tcga_brca.config) with one core: the MAST workers of the signature step
// each hold a copy of the data, and with 8 cores the signature of the full reference needed more
// than 480 GB. The subsampling runs with 100,000 and 150,000 cells used one core (peaks 257 / 334 GB).
includeConfig 'tcga_brca.config'

params {
  ncores = 1
}
profiles {
   apptainer {
      params.method_list = ["dwls"]
   }
}
