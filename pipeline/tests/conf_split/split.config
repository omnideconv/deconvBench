// regression tests with the reference split by donor (see ../conf/ for the tests without it)
// seed 4 leaves every cell type of the fixture in both parts; the fixture is too small for a
// meaningful minimum number of cells
params {
  split_reference                = true
  split_fraction_simulation      = 0.5
  split_min_cells                = 1
  split_min_cells_action         = 'warn'
  split_seed                     = 4
  split_reference_cells_fraction = 1
}
