// CI tests (GitHub Actions; also runs on the cluster): every workflow on data/ci with tiny settings,
// local executor sized for a GitHub runner (4 cores, 16 GB). Started by tests/ci/run_ci.sh.
// CI_INPUT  copy of data/ci for this run (simulations are written into it)
// CI_OUT    result directory of this run
// CI_BIND   directories bound into the containers (repository and run directory)
// IMG_STANDARD, IMG_AUTOGENES, IMG_RECTANGLE, IMG_SECRET   the four images (.sif files or sandboxes)

def ci_input = System.getenv('CI_INPUT')
def ci_out = System.getenv('CI_OUT')
def ci_bind = System.getenv('CI_BIND')
def img_standard = System.getenv('IMG_STANDARD')

params {
  data_dir_bulk = "${ci_input}/bulks/"
  data_dir_sc = "${ci_input}/single_cell/"
  preProcess_dir = "${ci_input}/preprocess"
  results_dir_general = "${ci_out}/results_general"
  results_dir_impact_technology = "${ci_out}/results_impact_technology"
  results_dir_spillover = "${ci_out}/results_spillover"
  results_dir_unknown_content = "${ci_out}/results_unknown_content"
  results_dir_resolution = "${ci_out}/results_resolution"
  results_dir_missing_cell_types = "${ci_out}/results_missing_cell_types"

  single_cell_list = ["sc-ci"]
  bulk_list = ["bulk-ci","bulk-nofacs"]
  method_list = ["music"]
  ncores = 1
  species_sc = 'hs'

  simulation_n_cells = [100]
  simulation_n_samples = [3]   // the metrics need at least 3 samples for a correlation per cell type
  simulation_sc_dataset = ["sc-ci"]
  simulation_scenario = ['random']
  simulation_bias_type = ['expressed_genes']

  ct_fractions = [100]
  replicates = 1
  replicates_simulation = [1]
  sc_datasets_impact_technology = ["sc-ci,sc-ci2"]
  bulk_impact_technology = ["bulk-ci"]
  spillover_celltypes = ["B cells","Monocytes classical"]
  known_cell_types = ["B cells,NK cells,T cells CD4 conv,Monocytes"]
  unknown_cell_type = ["Platelets.CD41+"]
  fractions_unknown_cells = [0, 0.5]
  replicates_unknown_content = [1]
  cell_types_finer_res = ["B cells s1, B cells s2, Monocytes, Monocytes classical, NK cells, T cells CD4 conv, T cells CD8 s1, T cells CD8 s2, Tregs, mDC, pDC_c4-IRF7+"]
  cell_types_to_exclude = ["T cells CD8","Monocytes","-"]

  // the split is switched on from the command line (--split_reference true --split_by cell|donor);
  // the CI data are too small for a minimum number of cells
  split_min_cells = 1
  split_min_cells_action = 'warn'
  split_seed = 4
}

executor {
  name = 'local'
  cpus = 4
  memory = '14 GB'
}

process {
  cpus = 1
  memory = 3.GB
  time = 1.h
  errorStrategy = 'terminate'
  container = img_standard
}

apptainer {
  enabled = true
  autoMounts = false
  runOptions = "--no-home --cleanenv --bind ${ci_bind}"
}

// one profile per image; simulation, subsampling and the split always run in the standard image
profiles {
  standard_methods {
    params.method_list = ["bayesprism","bisque","dwls","music","music-hc","scaden","scdc"]
  }
  autogenes {
    params.method_list = ["autogenes"]
    process {
      container = System.getenv('IMG_AUTOGENES')
      withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' { container = img_standard }
    }
  }
  rectangle {
    params.method_list = ["rectangle"]
    process {
      // rectangle starts one worker per CPU of the machine (n_cpus is not passed through), so one task at a time
      maxForks = 1
      container = System.getenv('IMG_RECTANGLE')
      withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' { container = img_standard }
    }
  }
  secret {
    params.method_list = ["secret"]
    process {
      container = System.getenv('IMG_SECRET')
      withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' { container = img_standard }
    }
  }
}
