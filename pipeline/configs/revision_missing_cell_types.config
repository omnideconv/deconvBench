// Revision: impact_missing_cell_types workflow with HaoCleaned as reference, split by donor.
// Bulk datasets: hoek and finotello. No pseudo-bulks are simulated; the methods use the method
// part of the split, the other donors are not used.
// Start it with scripts/run_revision_missing_cell_types.sh, which runs all profiles.
includeConfig '../conf/norm.config'

params {
  data_dir_sc                    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCellXGeneCensus/"
  // the description of the split (reference_split/)
  preProcess_dir                 = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/missing_cell_types"
  results_dir_missing_cell_types = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/missing_cell_types"
  ncores                         = 4
  memory_scale                   = 2

  single_cell_list               = ["HaoCleaned"]
  bulk_list                      = ["hoek","finotello"]

  // the cell types of supplementary figure 7; "-" leaves out none
  cell_types_to_exclude          = ["Tregs","T cells CD4 conv","T cells CD8","ILC","Plasma cells","NK cells","B cells","Monocytes","mDC","pDC","Platelet","-"]

  /*** reference split by donor ***/
  split_reference                = true
  split_fraction_simulation      = 0.5
  // HaoCleaned has 147,000 cells. A fifth of the method part (about 15,000 cells) is kept, the
  // size of HaoCleaned-sampled; the rarest cell type, ILC, then has 17 cells.
  split_reference_cells_fraction = 0.2
  split_min_cells                = 10
  split_min_cells_action         = 'error'
  split_seed                     = 1
}
