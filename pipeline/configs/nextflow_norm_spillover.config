params {

  /*** input directories ***/

  data_dir_bulk = "/nfs/data/omnideconv_benchmarking_clean/data/spillover/"                                                     
  data_dir_sc = "/nfs/data/omnideconv_benchmarking_clean/data/singleCellXGeneCensus"                                                 


  /*** output directories ***/  
  results_dir_general = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_rectangle_spillover2"                                                     
  preProcess_dir = "/nfs/data/omnideconv_benchmarking_clean/preprocess"                                     
  

  /*** Benchmarking Parameters [general] ***/  
  //single_cell_list = ["Arunachalam-sampled","BioResourceCollaboration-sampled","DominguezConde-sampled","Heimlich-sampled","HaoCleaned-sampled","Lee-sampled","SchulteSchrepping-sampled","TabulaSapiens-sampled"]
  single_cell_list = ["HaoCleaned-sampled"]   
  bulk_list = ["hoek_purified","linsley_purified"]
  method_list = ["rectangle"]                                                                       


  /*** general parameters ***/
  ncores = 8                                                                                  
  species_sc = 'hs' 
  memory_scale = 5                                                                     


  /****** Workflow-specific parameters ******/

  simulation_n_cells = [1000]
  simulation_n_samples = [50]
  simulation_sc_dataset = ["HaoCleaned"]
  simulation_scenario = ['random']
  simulation_bias_type = ['expressed_genes']

  /*** subsampling ***/

  ct_fractions = [100000]                                      // cell-type fractions for subsampling   
  replicates = 1                                                                                // number of replicates for subsampling
  

  /*** simulation_impact_technology ***/
  results_dir_impact_technology = "/path/to/impact_technology/results/"                         // results directory for this workflow
  replicates_simulation = [5]                                                                   // number of simulation replicates for this workflow
  datasets_impact_technology = ["lambrechts", "maynard"]                                        // names of sc datasets that are used for this workflow


  /*** simulation_spillover ***/
  results_dir_spillover = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_rectangle_spillover2"                                                    // results directory for this workflow
  spillover_celltypes = ["Tregs","T cells CD4 conv","T cells CD8","ILC","Plasma cells","NK cells","B cells","Monocytes","mDC","pDC","Platelet"]             // names of cell types for which spillover analysis will be done; have to be present in single-cell dataset                                     


  /*** simulation_unkown_content ***/
  results_dir_unkown_content = "/path/to/simulation_unkown_content/results/"                    // results directory for this workflow
  known_cell_types = ["B cells,Stromal cells,T cells CD4 conv,Macrophages"]                     // subset of cell types that we will use to build the signature matrix
  unkown_cell_types = ["Tumor cells"]                                                           // unknown cell type to use
  fractions_unkown_cells = [0, 0.2, 0.3, 0.9]                                                   // How large the fraction of the unkown cell type is
  replicates_unknown_content = [5]                                                              // number of technical replicates for pseudo-bulk simulation
 

  /*** simulation_resolution_analysis ***/
  results_dir_resolution = "/path/to/simulation_resolution_analysis/results/"                   // results directory for this workflow
  cell_types_finer_res = ["Endothelial ACKR1,Endothelial RGS5,Endothelial CXCL12, ..."]         //which cell types will we inspect at various resolutions?                                                   // number of simulation replicates for this workflow


  /*** impact_missing_cell_types ***/
  results_dir_missing_cell_types = "/path/to/impact_missing_cell_types/results/"                // results directory for this workflow
  cell_types_to_exclude = ["B cells","mDC","Monocytes","NK cells","T cells CD4 conv"]           // each of the cell types that will be excluded from the single cell dataset before deconvolution                                                 // in the spillover analysis samples contain only one cell types. How many samples we should generate this way

  
}

includeConfig '../conf/norm.config'

trace.file = '/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_downsample2/autogenes_100k-trace.csv'
