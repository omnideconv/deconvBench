// simulation_resolution_analysis workflow on the lambrechts dataset.
includeConfig '../conf/norm.config'

params {
  data_dir_sc                    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCell/"
  ncores                         = 8
  memory_scale                   = 3

  results_dir_resolution         = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_rectangle_resolution3"
  simulation_sc_dataset          = ["lambrechts"]
  simulation_n_cells             = [10000]
  simulation_n_samples           = [10]
  replicates_simulation          = [5]

  // cell types of the fine annotation that are simulated
  // wu
  //cell_types_finer_res         = ["Endothelial ACKR1, Endothelial RGS5, Endothelial CXCL12, CAFs MSC iCAF-like s1, CAFs MSC iCAF-like s2, CAFs Transitioning s3, CAFs myCAF like s4, CAFs myCAF like s5, PVL Differentiated s3, PVL_Immature s2, PVL Immature s1, Endothelial Lymphatic LYVE1, B cells Memory, B cells Naive, T_cells_c4_CD8+_ZFP36, T_cells_c6_IFIT1, T_cells_c5_CD8+_GZMK, T_cells_c7_CD8+_IFNG, T_cells_c8_CD8+_LAG3, T_cells_c0_CD4+_CCR7, T_cells_c1_CD4+_IL7R, T_cells_c2_CD4+_T-regs_FOXP3, T_cells_c3_CD4+_Tfh_CXCL13, T_cells_c9_NK_cells_AREG, T_cells_c11_MKI67, T_cells_c10_NKT_cells_FCGR3A, Myeloid_c10_Macrophage_1_EGR1, Myeloid_c12_Monocyte_1_IL1B, Myeloid_c2_LAM2_APOE, Myeloid_c1_LAM1_FABP5, Myeloid_c8_Monocyte_2_S100A9, Myeloid_c7_Monocyte_3_FCGR3A, Myeloid_c9_Macrophage_2_CXCL10, Cycling_Myeloid, Myeloid_c11_cDC2_CD1C, Myeloid_c4_DCs_pDC_IRF7, Myeloid_c3_cDC1_CLEC9A, Myeloid_c0_DC_LAMP3, Myoepithelial, Luminal Progenitors, Mature Luminal, Plasmablasts, Cancer Cycling, Cancer Her2 SC, Cancer LumB SC, Cancer Basal SC, Cycling PVL, Cancer LumA SC, Myeloid_c5_Macrophage_3_SIGLEC1"]         //which cell types will we inspect at various resolutions?
  // lambrechts
  cell_types_finer_res           = ["Macrophages, T cells CD4 non-reg, Fibroblasts adventitial, Tregs, Monocytes classical, NK cells, Tumor cells LUSC mitotic, Tumor cells LUAD, cDC2, Macrophage alveolar, Fibroblasts peribronchial, Mast cells, T cells NK-like, T cells CD8 terminally exhausted, Pericytes, T cells CD8 effector memory, Tumor cells LUSC, Plasma cells, cDC1, Tumor cells LUAD mitotic, T cells CD8 naive, Tumor cells NSCLC mixed, B cells, Fibroblasts alveolar, Alveolar cells type 2, Monocytes non-classical, Alveolar cells type 1, pDCs, Endothelial cells venous, Endothelial cells capillary, Endothelial cells arterial, Ciliated, Tumor cells LUAD EMT, T cells CD8 activated, Endothelial cells lymphatic, Club, Neutrophils"]
  // allen
  //cell_types_finer_res         = ["Astro, Endo_fine, L2/3 IT, L5 ET, L5 IT, L5/6 NP, L6 CT, L6 IT, L6 IT Car3, L6b, Lamp5, Micro-PVM, OPC, Oligo, Pvalb, Sncg, Sst, Sst Chodl, VLMC, Vip"]

  // read by the DWLS memory rule in the base config
  single_cell_list               = ["lambrechts"]
}

// only this method of the standard image
profiles {
     apptainer {
        params.method_list = ["scaden"]
     }
}
