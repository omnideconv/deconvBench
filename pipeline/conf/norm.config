// Settings for the DaisyBio cluster (login node norm), shared by the experiment configs in configs/.
// An experiment config defines its params, includes this file and can then override single settings.
//
// Profiles (one image per group of methods):
//   apptainer   Slurm, standard image; for bayesprism, bisque, dwls, music, scaden, scdc
//   autogenes   Slurm, older image that AutoGeneS needs
//   rectangle   Slurm, image with rectangle
//   cibersortx  local Docker; CIBERSORTx starts its own container through the Docker socket
// Start Nextflow with Java 17 on this cluster (see scripts/run.sh).

process{
   // All Slurm jobs run on the exbio nodes. AutoGeneS gives different results on compms-cpu-1,
   // the other node of the default partition, than on these.
   queue  = 'exbio-cpu'

   cpus   = { params.ncores      * task.attempt }
   memory = { 6.GB   * task.attempt * params.memory_scale }
   time   = { 4.h    * task.attempt }

   errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
   maxRetries    = 0
   maxErrors     = '-1'

   withLabel:process_high {
      cpus   = { params.ncores     * task.attempt }
      memory = { 48.GB * (task.attempt + params.memory_scale) }
      time   = { 16.h  * task.attempt }
   }
   withLabel:process_default {
      cpus   = { params.ncores     * task.attempt }
      memory = { 24.GB * (task.attempt + params.memory_scale) }
      time   = { 12.h  * task.attempt }
   }
   withLabel:process_small {
      cpus   = { params.ncores     * task.attempt }
      memory = { 18.GB * (task.attempt + params.memory_scale) }
      time   = { 6.h  * task.attempt }
   }

   // DWLS needs much more memory on the wu dataset
   withName: ANALYSIS_BULK_RESOLUTION_ANALYSIS {
      memory = { ('dwls' in params.method_list && 'wu' in params.single_cell_list)
                 ? 500.GB 
                 : 48.GB * (task.attempt + params.memory_scale) }
   }
}


profiles {
     standard {
        process.executor = 'local'
        docker.enabled = false
     }
     cibersortx {
        process.executor = 'local'
        docker.enabled = true
        process.container = 'alexd13/omnideconv_benchmark:2.0'
        docker.temp = "auto"
        docker.runOptions = "-v /var/run/docker.sock:/var/run/docker.sock -v /nfs/data/omnideconv_benchmarking_clean:/nfs/data/omnideconv_benchmarking_clean -v /nfs/proj/omnideconv_benchmarking:/nfs/proj/omnideconv_benchmarking"
     }
     apptainer {
        process.executor = 'slurm'
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
     autogenes {
        process.executor = 'slurm'
        process.cpus = 1
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_1_3/'
        // simulation and subsampling always run in the standard image, so that every method sees the same datasets
        process {
           withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
     rectangle {
        process.executor = 'slurm'
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_1/'
        // simulation and subsampling always run in the standard image, so that every method sees the same datasets
        process {
           withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
}

// use the `-with-trace` command to get tracing information on each job. Useful for the subsampling workflow, to see how resources scale with size of single-cell dataset
trace {
  fields = 'task_id,process,name,status,module,container,cpus,time,disk,memory,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,script'
  sep = ','
  overwrite = true
}
