// Base config of the DaisyBio cluster (login node norm). It defines where the data are, the
// resources of the processes and the profiles. The run configs in configs/ include this file and
// then set the parameters of one analysis; they can also override any value defined here.
// All parameters are described in ../nextflow.config and in the README.
//
// Profiles, one per container image. Each selects the methods that run in its image:
//   apptainer   Slurm, standard image: bayesprism, bisque, dwls, music, scaden, scdc
//               (also music-hc, the hierarchical MuSiC, for references with a coarser annotation
//               level; add it to the method list in the run config)
//   autogenes   Slurm, older image that AutoGeneS needs
//   rectangle   Slurm, image with rectangle (rectanglepy 1.7.0)
//   secret      Slurm, standard image plus SECRET
//   cibersortx  local Docker; CIBERSORTx starts its own container through the Docker socket
// To run only some methods of a profile, set them in the run config:
//   profiles { apptainer { params.method_list = ["dwls","scaden"] } }
//
// Start Nextflow with Java 17 on this cluster (scripts/run.sh does this).

params {

  /*** data on the cluster ***/
  data_dir_bulk  = "/nfs/data/omnideconv_benchmarking_clean/data/PBMC/"                        // bulk RNA-seq datasets
  data_dir_sc    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCellXGeneCensus"        // scRNA-seq datasets
  preProcess_dir = "/nfs/data/omnideconv_benchmarking_clean/preprocess"                        // subsampled and simulated datasets

  /*** resources ***/
  ncores       = 1                                                                             // cores per task
  memory_scale = 4                                                                             // factor on the memory of simulation and preprocessing tasks
  species_sc   = 'hs'

  // Memory in GB of a task that runs a method (signature, deconvolution, analysis workflows).
  // Set from the peak memory in the traces of earlier runs, plus about 50 %, for the references
  // HaoCleaned-sampled and lambrechts (the analysis workflows load all 64,000 cells, about 20 GB,
  // before they draw 500 cells per cell type). Highest peaks seen:
  //   dwls 36 (signature), rectangle 40, scaden 24, cibersortx 23, music 21, bisque 21,
  //   bayesprism 19, scdc 19, autogenes 15
  // A task that runs out of memory is repeated with twice and three times the value.
  // Larger references need more; peaks in the subsampling runs with 100,000 / 150,000 cells:
  //   dwls 257 / 334, bisque 105 / 164, scaden 100 / 148, bayesprism 86 / 126, music 105 / 108,
  //   scdc 96 / 96, cibersortx 66 / 97, autogenes 39 / 51
  // Override single values in a run config, e.g.  params.method_memory.dwls = 340
  method_memory = [
     autogenes : 24,
     bayesprism: 32,
     bisque    : 32,
     cibersortx: 32,
     dwls      : 56,
     music     : 32,
     'music-hc': 32,
     rectangle : 60,
     scaden    : 36,
     scdc      : 32,
     secret    : 32
  ]
}

process{
   // All Slurm jobs run on the exbio nodes. AutoGeneS gives different results on compms-cpu-1,
   // the other node of the default partition, than on these.
   queue  = 'exbio-cpu'

   cpus   = { params.ncores      * task.attempt }
   memory = { 6.GB   * task.attempt * params.memory_scale }
   time   = { 4.h    * task.attempt }

   // exit codes of a task that was killed, e.g. for exceeding its memory
   errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
   maxRetries    = 2
   maxErrors     = '-1'

   withLabel:process_high {
      cpus   = { params.ncores     * task.attempt }
      memory = { 48.GB * (task.attempt + params.memory_scale) }
      time   = { 16.h  * task.attempt }
   }
   withLabel:process_default {
      cpus   = { params.ncores     * task.attempt }
      memory = { 24.GB * (task.attempt + params.memory_scale) }
      time   = { 12.h  * task.attempt }
   }
   withLabel:process_small {
      cpus   = { params.ncores     * task.attempt }
      memory = { 18.GB * (task.attempt + params.memory_scale) }
      time   = { 6.h  * task.attempt }
   }

   // tasks that run a method get the memory of that method (params.method_memory)
   withName: 'CREATE_SIGNATURE.*|DECONVOLUTE' {
      memory = { 1.GB * (params.method_memory[meta.method] ?: 48) * task.attempt }
   }
   withName: 'ANALYSIS_.*' {
      memory = { 1.GB * (params.method_memory[method] ?: 48) * task.attempt }
   }
   // these load every reference completely, also the full HaoCleaned (147,000 cells, peaks of 36 to 52 GB)
   withName: 'ANALYSIS_PSEUDOBULK_MIRRORDB|ANALYSIS_BULK_MIRRORDB' {
      memory = { 1.GB * Math.max(params.method_memory[method] ?: 48, 64) * task.attempt }
   }
   // DWLS needs much more memory on the wu dataset; the largest node has 500,000 MB
   withName: ANALYSIS_BULK_RESOLUTION_ANALYSIS {
      memory = { (method == 'dwls' && sc_name == 'wu')
                 ? 1.GB * Math.min(200 * task.attempt, 480)
                 : 1.GB * (params.method_memory[method] ?: 48) * task.attempt }
   }
}

// at most this many jobs of one run in the Slurm queue at a time (scripts/slurm_throttle.sh can
// hold more of them back when other users are waiting)
executor {
   queueSize = 60
}


profiles {
     standard {
        process.executor = 'local'
        docker.enabled = false
     }
     cibersortx {
        params.method_list = ["cibersortx"]
        process.executor = 'local'
        // CIBERSORTx runs on the login node: use at most 16 cores and 160 GB at a time
        executor.cpus = 16
        executor.memory = 160.GB
        docker.enabled = true
        process.container = 'alexd13/omnideconv_benchmark:2.0'
        docker.temp = "auto"
        docker.runOptions = "-v /var/run/docker.sock:/var/run/docker.sock -v /nfs/data/omnideconv_benchmarking_clean:/nfs/data/omnideconv_benchmarking_clean -v /nfs/proj/omnideconv_benchmarking:/nfs/proj/omnideconv_benchmarking"
     }
     apptainer {
        params.method_list = ["bayesprism","bisque","dwls","music","scaden","scdc"]
        process.executor = 'slurm'
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
     autogenes {
        params.method_list = ["autogenes"]
        process.executor = 'slurm'
        process.cpus = 1
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_1_3/'
        // simulation, subsampling and the reference split always run in the standard image, so that every method sees the same datasets
        process {
           withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
     secret {
        params.method_list = ["secret"]
        process.executor = 'slurm'
        apptainer.enabled = true
        // standard image plus SECRET (see docker/add_secret.sh)
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2.4/'
        // simulation, subsampling and the reference split always run in the standard image, so that every method sees the same datasets
        process {
           withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'
     }
     rectangle {
        params.method_list = ["rectangle"]
        process.executor = 'slurm'
        apptainer.enabled = true
        // rectanglepy 1.7.0; image 2_1 has 1.0.0, image 2.2 has 1.2.1, image 2.3 has 1.6.0 (see docker/update_rectangle.sh)
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2.5/'
        // simulation, subsampling and the reference split always run in the standard image, so that every method sees the same datasets
        process {
           withName: 'SIMULATE_.*|PREPROCESS_SINGLE_CELL|SPLIT_REFERENCE' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'  // the work directory has to be bound: tasks read the outputs of other tasks
     }
}

// use the `-with-trace` command to get tracing information on each job. Useful for the subsampling workflow, to see how resources scale with size of single-cell dataset
trace {
  fields = 'task_id,process,name,status,module,container,cpus,time,disk,memory,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,script'
  sep = ','
  overwrite = true
}
