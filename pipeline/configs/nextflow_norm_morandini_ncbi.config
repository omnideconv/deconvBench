// Main workflow on the corrected (full NCBI) morandini bulk dataset.
// Do not reuse results of runs on the old truncated data.
includeConfig '../conf/norm.config'

params {
  results_dir_general            = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/results_main_morandini_ncbi"
  single_cell_list               = ["HaoCleaned-sampled"]
  bulk_list                      = ["morandini"]
}
