// Revision: resolution analysis of lambrechts as revision_resolution_lambrechts.config, but the
// reference is split within every fine cell type instead of by donor.
includeConfig 'revision_resolution_lambrechts.config'

params {
  preProcess_dir         = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/resolution_cellsplit"
  results_dir_resolution = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/resolution_cellsplit"
  split_by               = 'cell'
}
