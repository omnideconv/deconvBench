// Revision: simulation_resolution_analysis workflow on lambrechts with the reference split by donor.
// Start it with scripts/run_revision_resolution.sh, which runs lambrechts and wu with all profiles.
includeConfig '../conf/norm.config'

params {
  data_dir_sc                    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCell/"
  // pseudo-bulks (pseudo_bulk_resolution/) and the description of the split (reference_split/)
  preProcess_dir                 = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/resolution"
  results_dir_resolution         = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/resolution"
  ncores                         = 8
  memory_scale                   = 3

  simulation_sc_dataset          = ["lambrechts"]
  simulation_n_cells             = [10000]
  simulation_n_samples           = [10]
  replicates_simulation          = [5]

  // cell types of the fine annotation that are simulated
  cell_types_finer_res           = ["Macrophages, T cells CD4 non-reg, Fibroblasts adventitial, Tregs, Monocytes classical, NK cells, Tumor cells LUSC mitotic, Tumor cells LUAD, cDC2, Macrophage alveolar, Fibroblasts peribronchial, Mast cells, T cells NK-like, T cells CD8 terminally exhausted, Pericytes, T cells CD8 effector memory, Tumor cells LUSC, Plasma cells, cDC1, Tumor cells LUAD mitotic, T cells CD8 naive, Tumor cells NSCLC mixed, B cells, Fibroblasts alveolar, Alveolar cells type 2, Monocytes non-classical, Alveolar cells type 1, pDCs, Endothelial cells venous, Endothelial cells capillary, Endothelial cells arterial, Ciliated, Tumor cells LUAD EMT, T cells CD8 activated, Endothelial cells lymphatic, Club, Neutrophils"]

  // read by the DWLS memory rule in the base config
  single_cell_list               = ["lambrechts"]

  /*** reference split by donor ***/
  split_reference                = true
  split_fraction_simulation      = 0.5
  split_min_cells                = 50
  split_min_cells_action         = 'warn'
  split_seed                     = 23
  // seed 23 keeps every fine cell type in both parts. Fewer than 50 cells in one part: Club,
  // Neutrophils (1 cell), Pericytes, T cells CD8 activated and three tumour subtypes.
}

// the eight omnideconv methods, rectangle and music-hc
profiles {
     apptainer {
        params.method_list = ["bayesprism","bisque","dwls","music","music-hc","scaden","scdc"]
     }
}

// one task per method deconvolves all pseudo-bulks; the default time limit is too short for the slow methods
process {
   withName: ANALYSIS_BULK_RESOLUTION_ANALYSIS {
      time = 72.h
   }
}
