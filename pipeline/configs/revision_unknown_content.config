// Revision: simulation_unknown_content workflow on lambrechts with the reference split by donor.
// Design of the omnideconv benchmark (Fig. 5C): B cells, CD4+ T cells, stromal cells and
// macrophages as known cell types, tumour cells as unknown content at nine concentrations, five
// replicates of ten pseudo-bulk samples each (450 samples). The number of cells per sample is not
// given in the published methods; 10,000 is used here.
// Start it with scripts/run_revision_unknown_content.sh, which runs all profiles.
includeConfig '../conf/norm.config'

params {
  data_dir_sc                    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCell/"
  // pseudo-bulks (pseudo_bulk_unknown_content/) and the description of the split (reference_split/)
  preProcess_dir                 = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/unknown_content"
  results_dir_unknown_content    = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/unknown_content"
  ncores                         = 4
  memory_scale                   = 2

  simulation_sc_dataset          = ["lambrechts"]
  simulation_n_cells             = [10000]
  simulation_n_samples           = [10]
  known_cell_types               = ["B cells,Stromal cells,T cells CD4 conv,Macrophages"]
  unknown_cell_type              = ["Tumor cells"]
  fractions_unknown_cells        = [0, 0.05, 0.1, 0.2, 0.3, 0.5, 0.7, 0.8, 0.9]
  replicates_unknown_content     = [5]

  /*** reference split by donor ***/
  split_reference                = true
  split_fraction_simulation      = 0.5
  split_min_cells                = 50
  split_min_cells_action         = 'warn'
  split_seed                     = 23
  // seed 23 keeps every cell type of lambrechts in both parts; some fine cell types have fewer
  // than 50 cells in a part, which this workflow does not use
}

// the simulation has no memory label; it peaked at 30 GB on the complete dataset
process {
   withName: SIMULATE_BULK_UNKNOWN_CELL_TYPE {
      memory = { 40.GB * task.attempt }
   }
   // one task per method deconvolves all 450 pseudo-bulk samples; the default limit of 4 h is too short
   withName: ANALYSIS_BULK_UNKNOWN_CELL_TYPE {
      time = 72.h
   }
}

// Methods: the eight omnideconv methods, rectangle and secret (the default lists of the profiles).
