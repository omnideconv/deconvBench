// Revision: impact_missing_cell_types workflow with HaoCleaned-sampled as reference.
// Bulk datasets: hoek and finotello. No pseudo-bulks are simulated, so the reference is not split
// by donor: real bulks share no cells with the reference.
// Start it with scripts/run_revision_missing_cell_types.sh, which runs all profiles.
includeConfig '../conf/norm.config'

params {
  data_dir_sc                    = "/nfs/data/omnideconv_benchmarking_clean/data/singleCellXGeneCensus/"
  preProcess_dir                 = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/missing_cell_types"
  results_dir_missing_cell_types = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/missing_cell_types"
  ncores                         = 4
  memory_scale                   = 2

  // HaoCleaned downsampled to 14,744 cells from all eight donors
  single_cell_list               = ["HaoCleaned-sampled"]
  bulk_list                      = ["hoek","finotello"]

  // the cell types of supplementary figure 7; "-" leaves out none
  cell_types_to_exclude          = ["Tregs","T cells CD4 conv","T cells CD8","ILC","Plasma cells","NK cells","B cells","Monocytes","mDC","pDC","Platelet","-"]

  split_reference                = false
}

// A task that fails does not stop the other methods of the run. A task that was killed (memory,
// time) is repeated twice with more resources first. run_profiles.sh lists the failed tasks.
process.errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 2 ? 'retry' : 'ignore' }
