// Revision: unknown content as revision_unknown_content.config, but the reference is split within
// every cell type instead of by donor (no cell in both parts, every donor in both parts).
includeConfig 'revision_unknown_content.config'

params {
  preProcess_dir              = "/nfs/data/omnideconv_benchmarking_clean/preprocess/rectangle_revision/unknown_content_cellsplit"
  results_dir_unknown_content = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/unknown_content_cellsplit"
  split_by                    = 'cell'
}
