// Shared settings of the regression tests. Included by the per-workflow configs in this directory.
// TEST_INPUT: copy of the fixture this run reads from and writes simulations into
// TEST_OUT:   directory that receives the results of this run

def test_input = System.getenv('TEST_INPUT')
def test_out = System.getenv('TEST_OUT')

params {

  /*** input directories ***/
  data_dir_bulk = "${test_input}/bulks/"
  data_dir_sc = "${test_input}/single_cell/"

  /*** output directories ***/
  results_dir_general = "${test_out}/results_general"
  preProcess_dir = "${test_input}/preprocess"
  results_dir_impact_technology = "${test_out}/results_impact_technology"
  results_dir_spillover = "${test_out}/results_spillover"
  results_dir_unknown_content = "${test_out}/results_unknown_content"
  results_dir_resolution = "${test_out}/results_resolution"
  results_dir_missing_cell_types = "${test_out}/results_missing_cell_types"

  /*** Benchmarking Parameters [general] ***/
  single_cell_list = ["sc1"]
  bulk_list = ["bulk1","bulk2"]
  // method_list is set per profile below
  method_list = []

  /*** general parameters ***/
  ncores = 1
  species_sc = 'hs'

  /*** simulations ***/
  simulation_n_cells = [200]
  simulation_n_samples = [4]
  simulation_sc_dataset = ["sc1"]
  simulation_scenario = ['random']
  simulation_bias_type = ['expressed_genes']

  /*** subsampling ***/
  ct_fractions = [100, 200]
  replicates = 1

  /*** simulation_impact_technology ***/
  replicates_simulation = [2]
  sc_datasets_impact_technology = ["sc1,sc2"]
  bulk_impact_technology = ["bulk1"]

  /*** simulation_spillover ***/
  spillover_celltypes = ["B cells","Monocytes","NK cells","T cells CD8"]

  /*** simulation_unknown_content ***/
  known_cell_types = ["B cells,NK cells,T cells CD4 conv,Monocytes"]
  unknown_cell_type = ["Platelet"]
  fractions_unknown_cells = [0, 0.3, 0.7]
  replicates_unknown_content = [2]

  /*** simulation_resolution_analysis ***/
  cell_types_finer_res = ["B cells s1, B cells s2, Monocytes s1, Monocytes s2, NK cells, T cells CD4 conv, T cells CD8 s1, T cells CD8 s2, Tregs, mDC"]

  /*** impact_missing_cell_types ***/
  cell_types_to_exclude = ["T cells CD8","Monocytes","-"]
}

process {
   cpus   = 1
   memory = 8.GB
   time   = 2.h

   errorStrategy = 'finish'
   maxRetries    = 0
   maxErrors     = '-1'

   withLabel:process_high {
      memory = 16.GB
   }
   withLabel:process_default {
      memory = 16.GB
   }
}

// same containers as the production profiles in configs/
// /nfs/scratch is bound as well: tasks read the outputs of other tasks through symlinks into the work directory
profiles {
     cibersortx {
        params.method_list = ["cibersortx"]
        process.executor = 'local'
        docker.enabled = true
        process.container = 'alexd13/omnideconv_benchmark:2.0'
        docker.temp = "auto"
        docker.runOptions = "-v /var/run/docker.sock:/var/run/docker.sock -v /nfs/data/omnideconv_benchmarking_clean:/nfs/data/omnideconv_benchmarking_clean -v /nfs/proj/omnideconv_benchmarking:/nfs/proj/omnideconv_benchmarking"
     }
     apptainer {
        params.method_list = ["bayesprism","bisque","dwls","music","scaden","scdc"]
        process.executor = 'slurm'
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'
     }
     autogenes {
        params.method_list = ["autogenes"]
        process.executor = 'slurm'
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_1_3/'
        // these steps ran in the standard image in the reference run, whatever the method image was
        process {
           withName: 'SIMULATE_BULK|PREPROCESS_SINGLE_CELL|SIMULATE_BULK_RESOLUTION_ANALYSIS' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'
     }
     rectangle {
        params.method_list = ["rectangle"]
        process.executor = 'slurm'
        process.clusterOptions = "--nodelist=alfred.exbio.wzw.tum.de"
        apptainer.enabled = true
        process.container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_1/'
        // these steps ran in the standard image in the reference run, whatever the method image was
        process {
           withName: 'SIMULATE_BULK|PREPROCESS_SINGLE_CELL|SIMULATE_BULK_RESOLUTION_ANALYSIS' {
              container = '/nfs/proj/omnideconv_benchmarking/omnideconv/benchmark/docker/omnideconv_benchmark_2_0/'
           }
        }
        apptainer.autoMounts = false
        apptainer.runOptions = '--no-home --bind /nfs/data/,/nfs/proj,/nfs/scratch'
     }
}

trace {
  fields = 'task_id,process,name,status,exit,container,cpus,memory,realtime,peak_rss,script'
  sep = ','
  overwrite = true
}
