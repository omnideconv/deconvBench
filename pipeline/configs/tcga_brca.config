// TCGA-BRCA (1,091 primary tumours) deconvolved with wu at the normal annotation level, without
// cycling, myoepithelial, luminal and cancer epithelial cell types and without ribosomal genes
// (^RP[SL]|^RP\d|^RPSA); prepared by data/prepare_tcga_brca.R. The full reference (66,559 cells) is
// used; wu-normal-tcga is the same with at most 500 cells per cell type.
// The bulks have no ground truth, so no metrics are computed.
// Methods: the eight omnideconv methods, rectangle and secret (profiles apptainer, autogenes,
// rectangle, secret, cibersortx).
includeConfig '../conf/norm.config'

params {
  data_dir_sc         = "/nfs/data/omnideconv_benchmarking_clean/data/singleCell/"
  data_dir_bulk       = "/nfs/data/omnideconv_benchmarking_clean/data/TCGA-BRCA/"
  results_dir_general = "/nfs/data/omnideconv_benchmarking_clean/benchmark_results/rectangle_revision/tcga_brca"
  single_cell_list    = ["wu-normal-tcga-full"]
  bulk_list           = ["tcga-brca"]
  ncores              = 8

  // GB per task for the full reference, from the peaks of the subsampling runs with 100,000 cells
  // (dwls 257, bisque 105, scaden 100, bayesprism 86, music 105, scdc 96, cibersortx 66, autogenes 39);
  // rectangle and secret have not run with a reference of this size. A retry doubles the value;
  // dwls stays below the largest node (500 GB) on its retry.
  method_memory = [autogenes: 48, bayesprism: 110, bisque: 130, cibersortx: 100, dwls: 240, music: 130,
                   'music-hc': 130, rectangle: 120, scaden: 130, scdc: 120, secret: 120]
}

// DWLS runs separately with one core (configs/tcga_brca_dwls.config): with 8 cores its parallel
// workers need more than 480 GB for the signature of the full reference.
profiles {
   apptainer {
      params.method_list = ["bayesprism","bisque","music","scaden","scdc"]
   }
}

// 1,091 samples: deconvolution can take long for some methods
process {
   withName: 'CREATE_SIGNATURE.*|DECONVOLUTE' {
      time = 72.h
   }
}
process.errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 2 ? 'retry' : 'ignore' }
